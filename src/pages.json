        {
          "path": "pages/index",
          "style": {
            "navigationBarTitleText": "关于我们"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/products/index": {
      "network": "all",
      "packages": ["subpackage/products"]
    },
    "pages/news/index": {
      "network": "all",
      "packages": ["subpackage/news"]
    },
    "pages/about/index": {
      "network": "all",
      "packages": ["subpackage/about"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "医药包装设备",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F7FA"
  },
  "tabBar": {
    "color": "#6B7280",
    "selectedColor": "#E20101",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "/static/tabs/home.png",
        "selectedIconPath": "/static/tabs/home-select.png"
      },
      {
        "pagePath": "pages/products/index",
        "text": "产品",
        "iconPath": "/static/tabs/products.png",
        "selectedIconPath": "/static/tabs/products-select.png"
      },
      {
        "pagePath": "pages/news/index",
        "text": "新闻",
        "iconPath": "/static/tabs/news.png",
        "selectedIconPath": "/static/tabs/news-select.png"
      },
      {
        "pagePath": "pages/about/index",
        "text": "关于我们",
        "iconPath": "/static/tabs/about.png",
        "selectedIconPath": "/static/tabs/about-select.png"
      }
    ]
