      }
    },
    {
      "path": "pages/about/index",
      "style": {
        "navigationBarTitleText": "关于我们"
      }
    }
  ],
  "subPackages": [
    {
      "root": "subpackage/home",
      "pages": [
        {
          "path": "pages/index",
          "style": {
            "navigationBarTitleText": "首页",
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "subpackage/products",
      "pages": [
        {
          "path": "pages/index",
          "style": {
            "navigationBarTitleText": "产品中心"
          }
        },
        {
          "path": "pages/detail",
          "style": {
            "navigationBarTitleText": "设备详情"
          }
        }
      ]
    },
    {
      "root": "subpackage/news",
      "pages": [
        {
          "path": "pages/index",
          "style": {
            "navigationBarTitleText": "新闻资讯"
          }
        },
        {
          "path": "pages/detail",
          "style": {
            "navigationBarTitleText": "新闻详情"
          }
        }
      ]
    },
    {
      "root": "subpackage/about",
